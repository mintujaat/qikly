rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /plans/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    match /faq/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if id == "main";
      allow write: if false;
    }
    match /orders/{id} {
      allow read, write: if false;
    }
    match /subscriptions/{id} {
      allow read, write: if false;
    }
    match /admins/{id} {
      allow read, write: if false;
    }
    match /webhookEvents/{id} {
      allow read, write: if false;
    }
  }
}