# Firebase (same Firebase project can be kept)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Razorpay (keep your existing values)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# App session/admin
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=change-this-strong-password

# Cloudflare R2 - use the Access Key ID + Secret Access Key you already created
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=pdfs

# Optional: your Worker URL, kept for reference
R2_WORKER_URL=https://ebook-storage.busyjaat4.workers.dev
