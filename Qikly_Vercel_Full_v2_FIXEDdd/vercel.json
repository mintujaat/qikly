{
  "version": 2,
  "rewrites": [
    {"source":"/api/(.*)","destination":"/api/index.js"}
  ],
  "headers": [
    {"source":"/admin.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/admin-shop.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]},
    {"source":"/admin-shop.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0, must-revalidate"}]}
  ]
}
