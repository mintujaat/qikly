# Supabase project (server-side only). The URL is your project URL.
SUPABASE_URL=https://rhpwlxivnoupnjktesih.supabase.co
# Supabase Dashboard → Project Settings → API Keys → Secret key (sb_secret_...).
# Never put this in browser code, HTML, GitHub, or a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_YOUR_SECRET_KEY

# Razorpay (use Test Mode keys for initial testing)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
# Recommended: same value configured as Razorpay webhook secret
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Authentication cookies and admin login
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS

# Google OAuth web client (optional; both email/password flows remain available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/auth/google/callback

# LuvSMM API (server-side only)
LUVSMM_API_URL=https://luvsmm.com/api/v2
LUVSMM_API_KEY=REPLACE_WITH_YOUR_LUVSMM_API_KEY
LUVSMM_CURRENCY=INR
# Fallback only if the database settings row is absent; normally set this in /admin.
USD_TO_INR_RATE=

# Panel configuration
SITE_NAME=Mintu Social
DEFAULT_MARKUP_PERCENT=30
