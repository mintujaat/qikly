# Firebase Admin SDK - whole service-account JSON as a single environment value
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Razorpay deposits + legacy AI chat payments
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# App session signing. Set a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# ImgBB image hosting for admin plan photos
IMGBB_API_KEY=xxxxxxxxxxxxxxxx

# Gemini support chatbot / AI chat
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Admin panel password
ADMIN_PASSWORD=change-this-strong-password
